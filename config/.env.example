# ==============================================================================
# SOUQ // AUTONOMOUS AGENT COMMERCE SWARM CONFIGURATION
# ==============================================================================

# 1. Binance Market Microstructure Feed (Public Order Books & Depth)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# 2. Base Blockchain Settlement Rail (USDC Micropayments)
# Your public EVM address to receive instant USDC payments on Base
BASE_RECIPIENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Base RPC endpoint (default public or dedicated Alchemy/Infura)
BASE_RPC_URL=https://mainnet.base.org
# USDC Contract Address on Base Mainnet
BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# 3. Polar.sh Merchant of Record (Fiat / Developer Asset Vending)
POLAR_ACCESS_TOKEN=your_polar_personal_access_token_here
POLAR_ORGANIZATION_ID=your_polar_org_id_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here

# 4. Deployment & Infrastructure Tokens
GITHUB_ACCESS_TOKEN=your_github_token_here
KOYEB_API_TOKEN=your_koyeb_api_token_here

# 5. Security, Cryptographic Secrets & DDoS Protection
ENV=production
SOUQ_API_KEY_PEPPER=replace_with_high_entropy_random_secret_pepper
SOUQ_RECEIPT_SIGNING_KEY=replace_with_high_entropy_random_signing_key
SOUQ_IP_SALT=replace_with_random_telemetry_ip_salt
SOUQ_MAX_PAYLOAD_BYTES=1048576
SOUQ_RATE_LIMIT_PER_MINUTE=120
SOUQ_ALLOW_TEST_SIMULATION=false
SOUQ_ENABLE_FREE_TRIAL=true

# 6. Base Settlement Confirmation & Freshness Controls
SOUQ_CONFIRMATION_BLOCKS=1
SOUQ_MAX_TX_AGE_SECONDS=180
SOUQ_MAX_TOPUP_TX_AGE_SECONDS=86400
SOUQ_MIN_TOPUP_USD=0.50

# 7. Polar.sh SKU Mappings & Downloadable Asset URLs
POLAR_PRODUCT_ID_CREDIT_5=
POLAR_CHECKOUT_URL_CREDIT_5=
POLAR_PRODUCT_ID_CREDIT_15=
POLAR_CHECKOUT_URL_CREDIT_15=
POLAR_PRODUCT_ID_DATA_LAKE=
POLAR_CHECKOUT_URL_DATA_LAKE=
POLAR_PRODUCT_ID_EVAL_SUITE=
POLAR_CHECKOUT_URL_EVAL_SUITE=
POLAR_PRODUCT_ID_BOILERPLATE=
POLAR_CHECKOUT_URL_BOILERPLATE=
SOUQ_ASSET_URL_MICROSTRUCTURE=
SOUQ_ASSET_URL_GUARDRAILS=
SOUQ_ASSET_URL_BOILERPLATE=

# 8. Database & Telemetry Paths
DATABASE_URL=
SOUQ_DUCKDB_PATH=data/souq_treasury_lake.duckdb
SOUQ_RECEIPTS_DIR=data/receipts
SOUQ_EXPORTS_DIR=data/exports

